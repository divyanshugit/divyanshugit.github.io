---
layout: base.njk
pageCss: blog.css
pageJs:
  - /js/blog.js
bodyClass: page-blog
---
{#- The blog index: writing grouped by year, the date and reading time in the
    margin, tags as a quiet filter (js/blog.js). A series is one entry.
    Robust to posts without tags, dates or descriptions; drafts never reach
    collections.blog (see .eleventy.js and src/blog/blog.11tydata.js). -#}
{%- set ROMAN = ["", "i", "ii", "iii", "iv", "v", "vi", "vii", "viii", "ix", "x"] -%}
{%- set posts = collections.blog or [] -%}

{#- series: gather each one's parts (oldest first) -#}
{%- set seriesParts = { dp: [] } -%}
{%- for p in posts | reverse -%}
  {%- if p.data.series and p.data.series.id == "dp" %}{% set _ = seriesParts.dp.push(p) %}{% endif -%}
{%- endfor -%}

{#- the topics worth filtering by: tags on at least two posts, most used first -#}
{%- set seen = [] -%}{%- set topics = [] -%}{%- set sigs = [] -%}
{%- for p in posts -%}{%- for t in (p.data.tags or []) -%}
  {%- if t and (t not in seen) -%}
    {%- set _ = seen.push(t) -%}
    {%- set uses = [] -%}
    {%- for q in posts %}{% if t in (q.data.tags or []) %}{% set _ = uses.push(loop.index) %}{% endif %}{% endfor -%}
    {#- a tag that picks exactly the same posts as an earlier one adds nothing (PETs = Differential Privacy) -#}
    {%- set sig = uses | join(",") -%}
    {%- if uses.length > 1 and (sig not in sigs) %}{% set _ = sigs.push(sig) %}{% set _ = topics.push({ t: t, c: uses.length }) %}{% endif -%}
  {%- endif -%}
{%- endfor -%}{%- endfor -%}
{%- set topics = topics | sort(true, false, "c") -%}
{%- set feat = [] -%}{%- for p in posts %}{% if p.data.featured %}{% set _ = feat.push(1) %}{% endif %}{% endfor -%}
{%- set featuredCount = feat.length -%}

{%- set first = posts | last -%}{%- set latest = posts | first -%}

<section class="sheet page-head blog-head" id="top" aria-labelledby="blog-h">
  <div class="gut"></div>
  <div class="body">
    <p class="over lab noindent">Blog<span class="sep">·</span>{{ posts.length }} posts{% if first and latest %}, {{ first.date.getUTCFullYear() }}–{{ latest.date.getUTCFullYear() }}{% endif %}</p>
    <h1 id="blog-h">{{ pageTitle or title }}</h1>
    {%- if subtitle %}<p class="dek noindent">{{ subtitle }}</p>{% endif %}
    {{ content | safe }}

    <div class="filter" id="filter" role="group" aria-label="Filter posts by topic" hidden>
      <span class="lab filter__lab">Topics</span>
      <button type="button" class="filter__b" data-tag="" aria-pressed="true">all</button>
      {%- if featuredCount %}<button type="button" class="filter__b" data-tag="__featured" aria-pressed="false">selected</button>{% endif %}
      {%- for tp in topics %}<button type="button" class="filter__b" data-tag="{{ tp.t }}" aria-pressed="false">{{ tp.t }}</button>{% endfor %}
      <p class="filter__foot"><button type="button" class="filter__order" id="order" aria-pressed="false" aria-label="Show oldest first">oldest first</button><span class="filter__count" id="filter-count" aria-live="polite"></span></p>
    </div>
  </div>
</section>

<div class="years" id="years">
{%- for yr in posts | groupby("data.year") | dictsort | reverse %}
  {%- set year = yr[0] %}{% set ps = yr[1] %}
  <section class="sheet yr" id="y{{ year }}" aria-labelledby="h-{{ year }}">
    <div class="gut"><h2 class="yr__h" id="h-{{ year }}">{{ year }}</h2></div>
    <ol class="wide entries">
      {%- for post in ps %}
      {%- set s = post.data.series %}
      {%- set sparts = seriesParts[s.id] if (s and seriesParts[s.id]) else [] %}
      {%- if s and sparts.length > 1 %}
        {#- the whole series is one entry, placed at its latest part -#}
        {%- if post.url == (sparts | last).url %}
        {%- set allTags = [] %}{% set mins = [] %}
        {%- for sp in sparts %}{% for t in (sp.data.tags or []) %}{% if t not in allTags %}{% set _ = allTags.push(t) %}{% endif %}{% endfor %}{% set _ = mins.push((sp.templateContent | readingTime | replace(" min read", "")) | int) %}{% endfor %}
        {%- set sfeat = [] %}{% for sp in sparts %}{% if sp.data.featured %}{% set _ = sfeat.push(1) %}{% endif %}{% endfor %}{% set anyFeatured = sfeat.length %}
        <li class="entry entry--series" id="series-{{ s.id }}" data-parts="{{ sparts.length }}" data-tags="{{ allTags | join('|') }}"{% if anyFeatured %} data-featured{% endif %}>
          <div class="entry__main">
            <p class="entry__t entry__t--series"><span class="entry__kind lab">a series in {{ sparts.length }} parts</span>{{ s.name }}</p>
            <ol class="parts">
              {%- for sp in sparts %}
              <li><span class="parts__no">{{ ROMAN[loop.index] or loop.index }}</span><a href="{{ sp.url }}">{{ sp.data.title | cleanTitle | splitOn(":") | first }}</a></li>
              {%- endfor %}
            </ol>
          </div>
          <div class="entry__meta">
            <span class="entry__d">{{ (sparts | first).date | monthYear | splitOn(" ") | first }} – {{ (sparts | last).date | monthYear }}</span>
            <span class="entry__m">{{ mins | sum }} min, in all</span>
          </div>
        </li>
        {%- endif %}
      {%- else %}
        {%- set ptags = post.data.tags or [] %}
        {%- set gist = (post.data.description | cleanTitle | oneLine) if post.data.description else (post.templateContent | excerpt | oneLine) %}
        <li class="entry" data-tags="{{ ptags | join('|') }}"{% if post.data.featured %} data-featured{% endif %}>
          <div class="entry__main">
            {%- set words = ((post.data.title or "Untitled") | cleanTitle).split(" ") %}{% set lastWord = words.pop() %}
            <a class="entry__t" href="{{ post.url }}">{{ words.join(" ") }} <span class="nw">{{ lastWord }}<span class="arr" aria-hidden="true">&nbsp;→</span></span></a>
            {%- if gist %}<p class="entry__g">{{ gist }}</p>{% endif %}
          </div>
          <div class="entry__meta">
            <time class="entry__d" datetime="{{ post.date | isoDate }}">{{ post.date | longDate | replace(" " + year, "") }}</time>
            <span class="entry__m">{{ post.templateContent | readingTime | replace(" read", "") }}</span>
          </div>
        </li>
      {%- endif %}
      {%- endfor %}
    </ol>
  </section>
{%- endfor %}
</div>

<section class="sheet blog-foot" aria-label="Elsewhere">
  <div class="body">
    <p class="empty noindent" id="empty" hidden>Nothing under that topic yet. <button type="button" class="linkish" data-tag="">Show everything</button>.</p>
    <p class="noindent blog-foot__l">The shorter record of what happened when is on the <a href="/timeline.html">timeline</a>; the papers are under <a href="/publications.html">publications</a>.</p>
  </div>
</section>
