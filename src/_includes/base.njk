<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if title and title != "Home" %}{{ title }} · {% endif %}{{ site.name }}</title>
    {% if description %}<meta name="description" content="{{ description }}">{% endif %}

    {#- Social previews. A post with `banner: <slug>` uses its pre-generated card
        (src/assets/og/<slug>.png, `npm run og`); every other page uses the site card. -#}
    {%- set isPost = page.inputPath and ("/blog/" in page.inputPath) and banner %}
    {%- set ogTitle = (title | cleanTitle) if (title and title != "Home") else site.name %}
    {%- set ogDesc = (description | cleanTitle | replace(r/^tl;dr\s*[-—:]*\s*/i, "")) if description else (site.name + " · " + site.role + ". Research on AI safety, privacy and evaluation.") %}
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:type" content="{{ 'article' if isPost else 'website' }}">
    <meta property="og:title" content="{{ ogTitle }}">
    <meta property="og:description" content="{{ ogDesc }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:image" content="{{ site.url }}{{ (banner if isPost else '') | ogImage }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ ogTitle }}{% if isPost %}, with a figure drawn from the post{% endif %}">
    {%- if isPost %}<meta property="article:published_time" content="{{ page.date | isoDate }}">{% endif %}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:creator" content="@divyanshutwt">
    <meta name="twitter:title" content="{{ ogTitle }}">
    <meta name="twitter:description" content="{{ ogDesc }}">
    <meta name="twitter:image" content="{{ site.url }}{{ (banner if isPost else '') | ogImage }}">
    {#- The mark (DESIGN.md "Mark"): SVG first, ICO for browsers without SVG icons. -#}
    <link rel="icon" href="/assets/favicon.ico" sizes="32x32">
    <link rel="icon" type="image/svg+xml" href="/assets/logo.svg">
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content="#F5F1E8" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#191612" media="(prefers-color-scheme: dark)">

    {#- No-flash theme: only an explicit choice is applied; otherwise CSS follows the system. -#}
    <script>
        (function () {
            var d = document.documentElement;
            d.classList.add('js');
            try { var t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t); } catch (e) {}
            {%- if legacyCss %}
            // legacy stylesheet only knows [data-theme]; mirror the system without storing it
            if (!d.hasAttribute('data-theme') && window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches) d.setAttribute('data-theme', 'dark');
            {%- endif %}
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="{{ '/css/fonts.css' | cacheBust }}">

    {#- Pages not yet moved to the new system keep the old stylesheet (legacyCss: true). -#}
    {% if legacyCss %}<link rel="stylesheet" href="{{ '/css/legacy-fonts.css' | cacheBust }}"><link rel="stylesheet" href="{{ '/css/style.css' | cacheBust }}">{% endif %}
    <link rel="stylesheet" href="{{ '/css/site.css' | cacheBust }}">
    {% if pageCss %}<link rel="stylesheet" href="{{ ('/css/pages/' + pageCss) | cacheBust }}">{% endif %}

    {% if hasMath or hasCode %}
    <link rel="stylesheet" href="{{ '/css/prism-tomorrow.min.css' | cacheBust }}" />
    <link rel="stylesheet" href="{{ '/css/prism-toolbar.min.css' | cacheBust }}" />
    {% endif %}

    {#- Page-specific CSS, opt-in via `extraCss: [proposal.css]` (used by /proposal/*) -#}
    {% if extraCss %}{% for css in extraCss %}
    <link rel="stylesheet" href="{{ ('/css/' + css) | cacheBust }}">
    {% endfor %}{% endif %}

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-D9VESR00K0"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-D9VESR00K0');
    </script>

    {% if hasMath %}
    <script>
        window.MathJax = {
            tex: {
                inlineMath: [['$', '$'], ['\\(', '\\)']],
                displayMath: [['$$', '$$'], ['\\[', '\\]']],
                processEscapes: true,
                processEnvironments: true
            },
            options: {
                skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre'],
                ignoreHtmlClass: 'tex2jax_ignore',
                processHtmlClass: 'tex2jax_process'
            }
        };
    </script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    {% endif %}
</head>

<body class="{{ bodyClass or '' }}{% if legacyCss %} legacy{% endif %}">
    <a class="skip" href="#main">Skip to text</a>
    {% include "partials/masthead.njk" %}

    <main id="main">
    {{ content | safe }}
    </main>

    {% include "partials/colophon.njk" %}

    {#- The ε engine: facts from src/_data/particulars.js, used by any page that marks [data-f] or [data-eps-img]. -#}
    <script>window.EPS_FACTS = {{ particulars.facts | json | safe }};</script>
    <script src="{{ '/js/eps.js' | cacheBust }}"></script>
    <script src="{{ '/js/dmark.js' | cacheBust }}"></script>
    <script src="{{ '/js/site.js' | cacheBust }}"></script>

    {% if hasCode %}
    <script defer src="{{ '/js/vendor/prism-core.min.js' | cacheBust }}"></script>
    <script defer src="{{ '/js/vendor/prism-autoloader.min.js' | cacheBust }}" data-autoloader-path="/js/vendor/components/"></script>
    <script defer src="{{ '/js/vendor/prism-toolbar.min.js' | cacheBust }}"></script>
    <script defer src="{{ '/js/vendor/prism-copy-to-clipboard.min.js' | cacheBust }}"></script>
    {% endif %}
    {% if legacyCss %}<script src="{{ '/js/script.js' | cacheBust }}"></script>{% endif %}
    {% if pageJs %}{% for js in pageJs %}<script src="{{ js | cacheBust }}"></script>{% endfor %}{% endif %}
</body>
</html>
