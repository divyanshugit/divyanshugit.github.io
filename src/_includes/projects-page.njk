---
layout: base.njk
---

<div class="container">
    <div class="page-layout">
        <div class="page-header">
            <h1>{{ pageTitle }}</h1>
            <p class="page-subtitle">{{ subtitle }}</p>
        </div>

        <!-- Filter Options -->
        <div class="filter-section">
            <div class="filter-buttons">
                <button class="filter-btn active" data-filter="all">All Projects</button>
                <button class="filter-btn" data-filter="active">Active</button>
                <button class="filter-btn" data-filter="completed">Completed</button>
                <button class="filter-btn" data-filter="featured">Featured</button>
            </div>
        </div>

        <!-- Projects Grid -->
        <div class="projects-container" id="projectsContainer">
            <!-- Projects will be dynamically loaded here -->
        </div>

        <!-- Technologies Used -->
        <div class="technologies-section">
            <h3>Technologies & Tools</h3>
            <div class="tech-categories">
                {% for category in techCategories %}
                <div class="tech-category">
                    <h4>{{ category.name }}</h4>
                    <div class="tech-tags">
                        {% for tech in category.technologies %}
                        <span class="tech-tag">{{ tech }}</span>
                        {% endfor %}
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>

        {{ content | safe }}
    </div>
</div>

<!-- Modal for Project Details -->
<div id="modalOverlay" class="pub-modal-overlay">
    <div class="pub-modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <button id="modalClose" class="pub-modal__close" aria-label="Close details">&times;</button>
        <div id="modalStatus" class="pub-modal__badges"></div>
        <h2 id="modalTitle" class="pub-modal__title"></h2>
        <p id="modalDescription" class="pub-modal__desc"></p>
        <div id="modalDetails"></div>
        <div id="modalTechnologies" class="pub-modal__block"></div>
        <div id="modalLinks" class="pub-modal__block pub-modal__linkblock"></div>
    </div>
</div>

<script src="/data/projects.js"></script>
<script src="/js/projects-page.js"></script>

