---
layout: simple.njk
pagination:
  data: places
  size: 1
  alias: p
permalink: "/places/{{ p.id }}.html"
eleventyComputed:
  title: "{{ p.name }}"
  description: "{{ p.name }}: {{ p.caption }}"
---
<a class="back" href="/places.html">← all places</a>
<h1 class="title">{{ p.name }} <span class="muted" style="font-size:.6em">{{ p.local }}</span></h1>
<p class="facts"><span>{{ "wandered" if p.visited else "lived" }}</span>{% if p.region %}<span>{{ p.region }}</span>{% endif %}<span>Plate {{ p.plate }}</span></p>

<div class="photos">
{%- for ph in p.shown %}
  <figure>
    {%- if ph.blank %}<div class="th blank-th" style="aspect-ratio:2/1">photograph to come</div>
    {%- elif ph.srcset %}<picture><source type="image/avif" srcset="{{ ph.srcset.avif }}" sizes="(max-width: 820px) 100vw, 780px"><img src="{{ ph.src }}" srcset="{{ ph.srcset.webp }}" sizes="(max-width: 820px) 100vw, 780px" width="{{ ph.width }}" height="{{ ph.height }}" alt="{{ ph.alt }}" loading="lazy"></picture>
    {%- else %}<img src="{{ ph.src }}" width="{{ ph.width }}" height="{{ ph.height }}" alt="{{ ph.alt }}" loading="lazy">{% endif %}
    {%- if ph.caption %}<figcaption>{{ ph.caption }}</figcaption>{% endif %}
  </figure>
{%- endfor %}
</div>
{%- if p.credit %}<p class="credit">Photo: {{ p.credit.subject }} by {{ p.credit.by }}, <a href="{{ p.credit.licenseUrl }}">{{ p.credit.license }}</a>, via <a href="{{ p.credit.source }}">Wikimedia Commons</a>. A placeholder until I add my own.</p>{% endif %}

{%- if p.story %}{{ p.story | md | safe }}{% endif %}

{%- set here = work.entries | where("placeId", p.id) %}
{%- if here.length %}
<h2>what happened here</h2>
<ul class="list">{% for e in here %}<li><a href="/work/{{ e.id }}.html">{{ e.org }}</a> <span class="venue">· {{ e.role }} · {{ e.dates }}</span></li>{% endfor %}</ul>
{%- endif %}
